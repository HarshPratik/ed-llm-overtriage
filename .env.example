# OpenAI-compatible API (required to regenerate cases or re-run Terra evaluation)
OpenAI_baseURL=
OpenAI_API_KEY=

# Factory API (required to evaluate grok-4.6 / gemini-3.7-flash / glm-5.3-flash)
FACTORY_API_KEY=

# Local OpenAI-compatible model pool (required for Laguna S-2.1 / MiniMax M3)
POOL_BASE_URL=
POOL_API_KEY=

# Sarvam AI (required for sarvam-105b evaluation)
SARVAM_BASE_URL=https://api.sarvam.ai/v1
SARVAM_API_KEY=

# PhysioNet (only needed if you re-download MIMIC-IV-Ext CDS / DiReCT)
PHYSIONET_USERNAME=
PHYSIONET_PASSWORD=
